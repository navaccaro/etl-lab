{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weather Location",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "location_id",
    "display_name",
    "latitude",
    "longitude",
    "timezone",
    "enabled"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "location_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    }
  }
}